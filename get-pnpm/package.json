{
  "name": "get-pnpm",
  "version": "0.0.8",
  "description": "Installs pnpm as a standalone executable",
  "keywords": [
    "pnpm",
    "install",
    "installer"
  ],
  "license": "MIT",
  "funding": "https://opencollective.com/pnpm",
  "repository": "https://github.com/pnpm/get.pnpm.io/tree/main/get-pnpm",
  "homepage": "https://github.com/pnpm/get.pnpm.io/tree/main/get-pnpm#readme",
  "bugs": {
    "url": "https://github.com/pnpm/get.pnpm.io/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "!*.map",
    "bin"
  ],
  "bin": {
    "get-pnpm": "bin/get-pnpm.js"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "tsc && node --test test/*.test.ts",
    "prepublishOnly": "tsc"
  },
  "dependencies": {
    "confbox": "0.3.1",
    "picomatch": "4.0.7",
    "semver": "7.8.5"
  },
  "devDependencies": {
    "@pnpm/eslint-config": "^1100.0.2",
    "@types/node": "^24.10.1",
    "@types/picomatch": "^4.0.3",
    "@types/semver": "^7.8.0",
    "eslint": "^10.13.0",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-regexp": "^3.3.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
